# このファイルを .env としてコピーし、値を埋めて使う。
# .env / .env.enc / secret.key は .gitignore 済み。絶対にコミットしないこと。
#
# 暗号化して保管する場合は scripts/dev/encrypt_env.py を使う。
# secret.key と .env.enc が両方存在する場合、settings.py は .env より優先して復号する。

# ===== AI Provider (LLM) =====
# Claude API (Primary) — 必須
ANTHROPIC_API_KEY=

# Google Gemini API (Secondary / フェイルオーバー) — 任意
GOOGLE_API_KEY=

# DeepSeek API (Emergency Backup) — 任意
DEEPSEEK_API_KEY=

# ===== Market Data =====
# Alpha Vantage — 任意。US_STOCK の対象日 Close が yfinance で欠落した場合のみ fallback として使用
ALPHA_VANTAGE_API_KEY=

# ===== Mail (レポート配信) =====
# Gmail を使う場合はアプリパスワードを発行して SMTP_PASS に設定する
SMTP_USER=
SMTP_PASS=
SMTP_TO=
